# 复制为 .env 后填写。.env 已在 .gitignore 中排除。

# ---------- 向量化（任选一家，都兼容 OpenAI embeddings 协议）----------
# 硅基流动：https://api.siliconflow.cn/v1/embeddings   模型 BAAI/bge-m3（有免费额度）
# 智谱：    https://open.bigmodel.cn/api/paas/v4/embeddings   模型 embedding-3
EMBED_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH=16
# auto（默认）：配了 key 走接口，没配就自动退化为本地 bigram 哈希向量
# api / local：强制指定。local 只适合试跑，检索质量明显弱于 bge
EMBED_BACKEND=auto

# ---------- 对话模型 ----------
# 深度求索：https://api.deepseek.com/v1/chat/completions   模型 deepseek-chat
CHAT_API_URL=https://api.deepseek.com/v1/chat/completions
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat
CHAT_TEMPERATURE=0.8

# ---------- 切分与检索 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4

# ---------- 角色扮演 ----------
PERSONA_MAX_MATERIAL=12000   # 抽角色卡时喂给模型的原文上限（字）
HISTORY_TURNS=8              # 对话保留最近几轮
MEMORY_TOP_K=3               # 每轮检索几条「记忆」

# ---------- 路径 ----------
DATA_DIR=./data
CHROMA_DIR=./data/chroma
COLLECTION_NAME=narrative_docs

# ---------- 长期记忆 ----------
MEMORY_MAX_FACTS=50     # 每个角色最多存多少条事实
MEMORY_MAX_INJECT=15   # 每次注入 prompt 多少条
MEMORY_EXTRACT=1       # 设为 0 可关闭每轮的事实抽取（省一次模型调用）

# ---------- 知识范围 ----------
# full（默认）：角色知道全书发生的事，能聊任何情节
# perspective：角色只知道自己在场的事，越界会回避（更真实，但聊天不好用）
KNOWLEDGE_MODE=full
